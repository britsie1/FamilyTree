# Public website URL for social link previews (optional on Netlify, which provides URL).
# Include the base path if deploying under a subdirectory. No trailing slash required.
VITE_SITE_URL=https://your-site.example

# Firebase Web App Configuration
# Replace with your values from Firebase Console -> Project Settings -> General -> Your Apps (Web App)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
