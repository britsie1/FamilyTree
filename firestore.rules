rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwnerOf(data) {
      return isAuthenticated() && data.ownerId == request.auth.uid;
    }

    // Keep this encoding in sync with encodeEmailKey in firestoreService.ts.
    function emailKey() {
      return request.auth.token.email.lower()
        .replace('%', '%25').replace('[.]', '%2E')
        .replace('@', '%40').replace('/', '%2F');
    }

    function invitedRole(data) {
      return isAuthenticated() && request.auth.token.get('email', null) is string
        ? data.get('sharedWith', {}).get(emailKey(), {}).get('role', 'none')
        : 'none';
    }

    function isLegacyInvite(data) {
      return isAuthenticated() && request.auth.token.get('email', null) is string &&
             request.auth.token.email.lower() in data.get('sharedEmails', []);
    }

    function canReadData(data) {
      return data.get('isPublic', false) == true || isOwnerOf(data) ||
             invitedRole(data) in ['viewer', 'editor'] || isLegacyInvite(data);
    }

    function canEditData(data) {
      // An explicit viewer invitation takes precedence over a public editor link.
      // Legacy email-only invitations never grant write access.
      return isAuthenticated() && (isOwnerOf(data) || invitedRole(data) == 'editor' ||
        (invitedRole(data) == 'none' && !isLegacyInvite(data) &&
         data.get('isPublic', false) == true && data.get('publicRole', 'viewer') == 'editor'));
    }

    function canReadTree(treeId) {
      return canReadData(get(/databases/$(database)/documents/trees/$(treeId)).data);
    }

    function isTreeOwner(treeId) {
      return isOwnerOf(get(/databases/$(database)/documents/trees/$(treeId)).data);
    }

    function canEditTree(treeId) {
      return canEditData(get(/databases/$(database)/documents/trees/$(treeId)).data);
    }

    function isValidPersonDoc(data, personId) {
      return data.id == personId &&
             data.id is string &&
             (!('deleted' in data) || data.deleted is bool) &&
             (!('rev' in data) || data.rev is int || data.rev is number) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (data.get('deleted', false) == true || (
               (!('firstName' in data) || data.firstName is string) &&
               (!('lastName' in data) || data.lastName is string) &&
               (!('gender' in data) || (data.gender is string && data.gender in ['male', 'female', 'other', 'unknown', 'unspecified'])) &&
               (!('unionIds' in data) || data.unionIds is list)
             ));
    }

    function isValidUnionDoc(data, unionId) {
      return data.id == unionId &&
             data.id is string &&
             (!('deleted' in data) || data.deleted is bool) &&
             (!('rev' in data) || data.rev is int || data.rev is number) &&
             (!('updatedAt' in data) || data.updatedAt is string) &&
             (data.get('deleted', false) == true || (
               (!('partnerIds' in data) || data.partnerIds is list) &&
               (!('childrenIds' in data) || data.childrenIds is list)
             ));
    }

    // Rules for family tree documents
    match /trees/{treeId} {
      // Missing root gets support checking whether a local tree was uploaded.
      // This exception must not apply to subcollection records or list queries.
      allow get: if resource == null || canReadData(resource.data);
      allow list: if canReadData(resource.data);

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid;

      allow update: if request.resource.data.ownerId == resource.data.ownerId && (
        isOwnerOf(resource.data) ||
        (canEditData(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'name', 'description', 'rootPersonId', 'collapsedPersonIds',
           'people', 'unions', 'googleDriveConfig', 'layoutOverrides', 'horizontalOverrides',
           'storageMode', 'schemaVersion', 'version', 'updatedAt'
         ]))
      );

      allow delete: if isOwnerOf(resource.data);

      // Subcollection for individual people documents with shape validation and compaction permissions
      match /people/{personId} {
        allow read: if canReadTree(treeId);

        allow create, update: if canEditTree(treeId) &&
                                 isValidPersonDoc(request.resource.data, personId);

        // Delete allowed for owner (hard delete), or for authorized editor ONLY when deleting tombstones during compaction
        allow delete: if isAuthenticated() && (
          isTreeOwner(treeId) ||
          (canEditTree(treeId) && resource.data.get('deleted', false) == true)
        );
      }

      // Subcollection for individual relationship/union documents with shape validation and compaction permissions
      match /unions/{unionId} {
        allow read: if canReadTree(treeId);

        allow create, update: if canEditTree(treeId) &&
                                 isValidUnionDoc(request.resource.data, unionId);

        // Delete allowed for owner (hard delete), or for authorized editor ONLY when deleting tombstones during compaction
        allow delete: if isAuthenticated() && (
          isTreeOwner(treeId) ||
          (canEditTree(treeId) && resource.data.get('deleted', false) == true)
        );
      }
    }
  }
}
